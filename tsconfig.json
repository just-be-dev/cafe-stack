{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "paths": { "@/*": ["./src/ui/*"] },
    "types": ["@cloudflare/workers-types", "bun", "vite/client"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedDuplicatedPackages": ["effect-oxlint"],
        "overrides": [
          {
            "include": ["src/ui/**/command.ts", "src/platform/cloudflare/api.ts"],
            "options": { "allowedUnstableApis": ["effect/http"] }
          },
          {
            "include": ["src/rpc.ts"],
            "options": { "allowedUnstableApis": ["effect/rpc"] }
          },
          {
            "include": ["src/api.ts", "src/ui/api.ts"],
            "options": { "allowedUnstableApis": ["effect/http", "effect/rpc"] }
          },
          {
            "include": ["src/**/*.test.ts"],
            "options": { "allowedUnstableApis": ["@effect/vitest"] }
          },
          {
            "include": ["src/api.test.ts", "src/rpc.test.ts", "src/ui/api.test.ts"],
            "options": { "allowedUnstableApis": ["effect/http", "effect/rpc", "@effect/vitest"] }
          }
        ]
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "alchemy.run.ts",
    "oxlint.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
